<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventSpotter.Views.MainSitePage"
             BackgroundColor="#020810"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="60, Auto, *">

        <!-- 1. NAV BAR -->
        <Border Grid.Row="0"
                BackgroundColor="#E6020810"
                StrokeThickness="0">
            <Border.StrokeShape>
                <Rectangle/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *, Auto"
                  Padding="20,0">

                <Button Text="← BACK"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="#3a5068"
                        FontFamily="OpenSansRegular"
                        FontSize="11"/>

                <Label Grid.Column="1"
                       Text="EVENT SPOTTER"
                       TextColor="#00d4ff"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontFamily="OpenSansRegular"
                       CharacterSpacing="3"/>

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="15"
                                       VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Ellipse WidthRequest="6" HeightRequest="6"
                                 Fill="#06d6a0" VerticalOptions="Center"/>
                        <Label Text="LIVE"
                               TextColor="#06d6a0"
                               FontSize="10"
                               FontFamily="OpenSansRegular"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label x:Name="EventCountLabel"
                           Text="0 EVENTS"
                           TextColor="#3a5068"
                           FontSize="10"
                           FontFamily="OpenSansRegular"
                           VerticalOptions="Center"/>
                    <Button Text="LOGIN"
                            Clicked="OnLoginClicked"
                            BackgroundColor="Transparent"
                            TextColor="#3a5068"
                            FontSize="11"
                            FontFamily="OpenSansRegular"/>
                    <Button Text="⚙ PREFS"
                            Clicked="OnPrefsClicked"
                            BackgroundColor="Transparent"
                            TextColor="#3a5068"
                            FontSize="11"
                            FontFamily="OpenSansRegular"/>
                </HorizontalStackLayout>

            </Grid>
        </Border>

        <!-- 2. FILTERS -->
        <Border Grid.Row="1"
                BackgroundColor="#BF020810"
                StrokeThickness="0"
                Padding="20,12">
            <Border.StrokeShape>
                <Rectangle/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, *, *, Auto"
                  ColumnSpacing="10">

                <Entry x:Name="SearchEntry"
                       Placeholder="Search events..."
                       TextColor="White"
                       PlaceholderColor="#3a5068"
                       BackgroundColor="#0D00D4FF"
                       FontFamily="OpenSansRegular"
                       TextChanged="OnSearchChanged"/>

                <Picker x:Name="CountryPicker"
                        Grid.Column="1"
                        Title="ALL COUNTRIES"
                        TextColor="White"
                        BackgroundColor="#0D00D4FF"
                        FontFamily="OpenSansRegular"
                        SelectedIndexChanged="OnFilterChanged"/>

                <Picker x:Name="CategoryPicker"
                        Grid.Column="2"
                        Title="ALL TYPES"
                        TextColor="White"
                        BackgroundColor="#0D00D4FF"
                        FontFamily="OpenSansRegular"
                        SelectedIndexChanged="OnFilterChanged"/>

                <Button x:Name="FreeBtn"
                        Grid.Column="3"
                        Text="FREE: OFF"
                        Clicked="OnFreeToggled"
                        BackgroundColor="#0D00D4FF"
                        TextColor="#3a5068"
                        FontFamily="OpenSansRegular"
                        CornerRadius="2"/>
            </Grid>
        </Border>

        <!-- 3. MAIN BODY -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Hero section -->
                <VerticalStackLayout x:Name="HeroSection"
                                     Spacing="16"
                                     Padding="0,40"
                                     HorizontalOptions="Center">
                    <Label Text="DISCOVER WHAT'S"
                           TextColor="White"
                           FontSize="40"
                           HorizontalTextAlignment="Center"
                           FontFamily="OpenSansRegular"/>
                    <Label Text="HAPPENING NOW"
                           TextColor="#00d4ff"
                           FontSize="40"
                           HorizontalTextAlignment="Center"
                           FontFamily="OpenSansRegular">
                        <Label.Shadow>
                            <Shadow Brush="#00d4ff" Offset="0,0" Radius="30" Opacity="0.3"/>
                        </Label.Shadow>
                    </Label>
                    <Label x:Name="StatsLabel"
                           Text="Loading events..."
                           TextColor="#3a5068"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           FontFamily="OpenSansRegular"/>
                    <Button Text="ENTER DISCOVERY MODE →"
                            Clicked="OnHideHero"
                            BackgroundColor="#00d4ff"
                            TextColor="#020810"
                            FontAttributes="Bold"
                            FontFamily="OpenSansRegular"
                            CornerRadius="2"
                            HorizontalOptions="Center"
                            Padding="30,14"/>
                </VerticalStackLayout>

                <!-- Loading indicator -->
                <ActivityIndicator x:Name="LoadingSpinner"
                                   IsRunning="True"
                                   IsVisible="True"
                                   Color="#00d4ff"
                                   HorizontalOptions="Center"/>

                <!-- Event grid -->
                <FlexLayout x:Name="EventGrid"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            AlignContent="Start"/>

                <!-- Empty state -->
                <VerticalStackLayout x:Name="EmptyState"
                                     IsVisible="False"
                                     HorizontalOptions="Center"
                                     Spacing="10"
                                     Padding="0,40">
                    <Label Text="◎"
                           TextColor="#3a5068"
                           FontSize="32"
                           HorizontalTextAlignment="Center"
                           Opacity="0.3"/>
                    <Label Text="NO SIGNALS DETECTED"
                           TextColor="#3a5068"
                           FontSize="11"
                           HorizontalTextAlignment="Center"
                           CharacterSpacing="2"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>